; Engine configuration file.
; Gerado para Godot 4.x. Edite pelo editor da Godot quando possível.

config_version=5

[application]

config/name="Ordem Paranormal"
config/description="RPG tático com exploração em tempo real e combate por turnos."
run/main_scene="res://scenes/exploration/test_room.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[gui]

theme/custom_font="res://assets/fonts/SpecialElite-Regular.ttf"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
