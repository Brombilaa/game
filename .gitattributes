# Arte e fontes
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
# Áudio
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
# Vídeo (cutscenes)
*.webm filter=lfs diff=lfs merge=lfs -text
*.ogv filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
# Fontes tipográficas
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
# Texto com fim de linha normalizado
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.md text eol=lf

# Exceção: a Special Elite (150 KB) vai direto no Git porque o envio ao LFS foi recusado
# (403) no ambiente da nuvem. Migrar para o LFS depois com `git lfs migrate import`.
# O mesmo vale para as folhas de sprites dos personagens (algumas dezenas de KB cada).
assets/fonts/SpecialElite-Regular.ttf -filter -diff -merge -text
assets/sprites/personagens/*.png -filter -diff -merge -text
# O cenário isométrico (chão, paredes, móveis) também vai direto no Git, como os personagens.
assets/sprites/cenario/*.png -filter -diff -merge -text
# Os retratos dos protagonistas (64 e 128 px) também vão direto no Git.
assets/sprites/retratos/*.png -filter -diff -merge -text
